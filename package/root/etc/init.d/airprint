#!/bin/sh /etc/rc.common
START=98
STOP=20
USE_PROCD=1

start_service() {
	if [ "$(uci -q get airprint.main.enabled)" = "0" ]; then
		/usr/sbin/airprint-avahi remove
		return 0
	fi
	mkdir -p /var/log/airprint
	mkdir -m 0777 -p /tmp/airprint /tmp/airprint/urf
	mkdir -m 0777 -p /overlay/ipps_tmp 2>/dev/null
	chmod 777 /tmp/airprint /tmp/airprint/urf 2>/dev/null
	/usr/sbin/airprint-avahi sync
	/usr/sbin/airprint-setup sync-cups >/dev/null 2>&1
	procd_open_instance
	procd_set_param command /usr/sbin/airprint-proxy
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

reload_service() {
	/usr/sbin/airprint-setup apply
}
